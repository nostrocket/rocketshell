{
  "name": "kehto-applesauce-host-platform",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "pnpm --filter '@platform/*-napplet' build && pnpm -r --filter '!@platform/*-napplet' --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:conformance": "pnpm --filter '@platform/*-napplet' test:conformance",
    "dev": "pnpm --filter '@platform/*-napplet' build && pnpm --parallel --filter '@platform/*-napplet' --filter @platform/shell dev"
  },
  "devDependencies": {
    "@napplet/conformance": "0.16.1",
    "@napplet/conformance-cli": "0.2.18",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@napplet/conformance": "0.16.1",
      "@napplet/core": "0.31.1",
      "@napplet/nap": "0.31.1"
    }
  }
}
